PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's dev/prod URLs)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Local Postgres:      postgresql://smartdesk:smartdesk@localhost:5432/smartdesk
# docker-compose:      postgresql://smartdesk:smartdesk@postgres:5432/smartdesk (set automatically)
DATABASE_URL=postgresql://smartdesk:smartdesk@localhost:5432/smartdesk

# Optional: if set, /api/ai/ask calls a real LLM (Claude) instead of the
# built-in, knowledge-base-grounded mock.
# Never put this key in the frontend - it must only ever live here on the server.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for replies (default: claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5
